# Copy to .env and adjust.

# --- required: SEC wants a real contact in the User-Agent ---
SEC_USER_AGENT=newsbot your.name@example.com

# --- local LLM (OpenAI-compatible endpoint) ---
# Ollama:     http://localhost:11434/v1   (model name = `ollama list`)
# LM Studio:  http://localhost:1234/v1
# llama.cpp:  http://localhost:8080/v1    (llama-server --jinja)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.6:35b-a3b
LLM_THINKING=0
LLM_JSON_MODE=json_object

# --- optional ---
# RSS_FEEDS=https://example.com/feed1.xml,https://example.com/feed2.xml
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# MAX_POSITIONS=10
# HOLD_DAYS=5
# ENTRY_THRESHOLD=0.5
